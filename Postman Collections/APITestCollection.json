	"item": [
		{
			"name": "GetUsers",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "38c51e17-c4fe-4b6c-8c08-d6b4c8a7ce1c",
						"exec": [
							"//get count of records",
							"//print names of all users",
							"",
							"const responseJson = pm.response.json();",
							"",
							"pm.test(\"Verify response status\", ()=>{",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"validate per page user count\",()=>{",
							"    pm.expect(responseJson.per_page===6,\"Per page count is 6.\");",
							"});",
							"",
							"pm.test(\"Validate data keys\", ()=>{",
							"    pm.expect(responseJson.data[0]).to.have.property(\"id\");",
							"});",
							"",
							"//save id for user",
							"const userData = responseJson.data;",
							"const filteredUser = userData.filter(user=>user.first_name==pm.environment.get(\"user_first_name\"));",
							"pm.environment.set(\"user_id\",filteredUser[0].id);",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"id": "a76e4f55-1538-4c0a-8955-6c61bb99ca21",
			"protocolProfileBehavior": {
				"disableBodyPruning": true
			},
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "x-api-key",
						"value": "{{api_key}}",
						"type": "text"
					}
				],
				"url": "{{base_url}}/api/users"
			},
			"response": []
		},
